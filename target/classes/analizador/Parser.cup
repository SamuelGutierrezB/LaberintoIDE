package analizador;

import java_cup.runtime.*;
import modelo.*;
import java.util.*;

parser code {:
    private Laberinto laberinto;
    
    // Métodos de utilidad para el parser
    private void validarCoordenadas(int x, int y) {
        if (laberinto == null) {
            throw new IllegalArgumentException("Laberinto no inicializado. Use ROOM primero.");
        }
        if (x < 0 || x >= laberinto.getAncho() || y < 0 || y >= laberinto.getAlto()) {
            throw new IllegalArgumentException("Coordenadas fuera de rango (0-" + (laberinto.getAncho()-1) + ")");
        }
    }
    
    // Métodos para ejecutar comandos directamente en el parser
    private void crearLaberinto(int ancho, int alto) {
        laberinto = new Laberinto(ancho, alto);
    }

    private void togglePared(int x, int y) {
        validarCoordenadas(x, y);
        laberinto.togglePared(x, y);
    }

    private void setCeldaInicio(int x, int y) {
        validarCoordenadas(x, y);
        laberinto.setCeldaInicio(x, y);
    }

    private void setCeldaFin(int x, int y) {
        validarCoordenadas(x, y);
        laberinto.setCeldaFin(x, y);
    }

    private void agregarPuerta(int x, int y) {
        validarCoordenadas(x, y);
        laberinto.getCelda(x, y).setEntidad(new Entidad.Puerta(x, y));
    }

    private void agregarMonstruo(int x, int y) {
        validarCoordenadas(x, y);
        laberinto.getCelda(x, y).setEntidad(new Entidad.Monstruo(x, y));
    }

    private void encontrarCamino() {
        laberinto.limpiarCaminos();
        List<Celda> camino = laberinto.encontrarCaminoDijkstra();
        if (camino.isEmpty()) {
            throw new IllegalArgumentException("No hay camino o falta START/END");
        }
        for (Celda celda : camino) {
            celda.setEnCamino(true);
        }
    }

    private void limpiarCaminos() {
        laberinto.limpiarCaminos();
    }
    
    // Método público para obtener el laberinto
    public Laberinto getLaberinto() {
        return laberinto;
    }
:};

/* Terminales (tokens) */
terminal String ROOM, WALL, START, END, DOOR, MONSTER, GO, CLEAR_PATH;
terminal Integer NUMBER;

/* No terminales */
non terminal command;
non terminal room_command;
non terminal wall_command;
non terminal start_command;
non terminal end_command;
non terminal door_command;
non terminal monster_command;

/* Gramática */
start with command;

command ::= room_command 
          | wall_command 
          | start_command 
          | end_command 
          | door_command 
          | monster_command 
          | GO {: encontrarCamino(); :}
          | CLEAR_PATH {: limpiarCaminos(); :}
          ;

room_command ::= ROOM NUMBER NUMBER {: 
                    crearLaberinto((Integer)$2, (Integer)$3); 
                :};

wall_command ::= WALL NUMBER NUMBER {: 
                    togglePared((Integer)$2, (Integer)$3); 
                :};

start_command ::= START NUMBER NUMBER {: 
                    setCeldaInicio((Integer)$2, (Integer)$3); 
                 :};

end_command ::= END NUMBER NUMBER {: 
                    setCeldaFin((Integer)$2, (Integer)$3); 
               :};

door_command ::= DOOR NUMBER NUMBER {: 
                    agregarPuerta((Integer)$2, (Integer)$3); 
                :};

monster_command ::= MONSTER NUMBER NUMBER {: 
                    agregarMonstruo((Integer)$2, (Integer)$3); 
                   :};